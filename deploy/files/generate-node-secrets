#!/bin/sh
set -eu

secrets_dir=${VPN_SECRETS_DIR:-/opt/vpn-node/secrets}
state_file="$secrets_dir/node-secrets.json"

if [ -f "$state_file" ]; then
    exit 0
fi

: "${XRAY_IMAGE:?XRAY_IMAGE is required}"
umask 077
mkdir -p "$secrets_dir"

lock_dir="$secrets_dir/.node-secrets.lock"
temporary_file=

cleanup() {
    if [ -n "$temporary_file" ]; then
        rm -f "$temporary_file"
    fi
    rmdir "$lock_dir" 2>/dev/null || true
}

if ! mkdir -m 0700 "$lock_dir" 2>/dev/null; then
    echo "Another node secret initialization is in progress" >&2
    exit 1
fi
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ -f "$state_file" ]; then
    exit 0
fi

legacy_xray_config="$secrets_dir/xray-config.json"
legacy_hysteria_config="$secrets_dir/hysteria-config.yaml"
legacy_runtime=false

if [ -e "$legacy_xray_config" ] || [ -e "$legacy_hysteria_config" ]; then
    if [ ! -f "$legacy_xray_config" ] || [ ! -f "$legacy_hysteria_config" ]; then
        echo "Incomplete legacy runtime configuration; refusing to rotate keys" >&2
        exit 1
    fi
    legacy_runtime=true
fi

temporary_file=$(mktemp "$secrets_dir/.node-secrets.XXXXXX")

if [ "$legacy_runtime" = true ]; then
    python3 - "$legacy_xray_config" "$legacy_hysteria_config" \
        "$temporary_file" <<'PY'
import json
import re
import sys

xray_path, hysteria_path, output_path = sys.argv[1:]
with open(xray_path, encoding="utf-8") as stream:
    xray = json.load(stream)
with open(hysteria_path, encoding="utf-8") as stream:
    hysteria = json.load(stream)

inbounds = [
    item
    for item in xray["inbounds"]
    if item.get("tag") == "vless-reality"
    and item.get("protocol") == "vless"
    and item.get("streamSettings", {}).get("security") == "reality"
]
if len(inbounds) != 1:
    raise ValueError("Expected exactly one legacy VLESS/REALITY inbound")
inbound = inbounds[0]
reality = inbound["streamSettings"]["realitySettings"]
private_key = reality["privateKey"]
short_ids = reality["shortIds"]
obfs = hysteria["obfs"]
if obfs.get("type") != "salamander":
    raise ValueError("Legacy Hysteria obfs must use salamander")
hysteria_obfs = obfs["salamander"]["password"]
if not isinstance(private_key, str) or not private_key:
    raise ValueError("Legacy REALITY private key is missing")
if not isinstance(short_ids, list) or len(short_ids) != 1:
    raise ValueError("Legacy REALITY short ID is invalid")
short_id = short_ids[0]
if (
    not isinstance(short_id, str)
    or len(short_id) > 16
    or len(short_id) % 2 != 0
    or re.fullmatch(r"[0-9a-fA-F]*", short_id) is None
):
    raise ValueError("Legacy REALITY short ID is invalid")
if not isinstance(hysteria_obfs, str) or not hysteria_obfs:
    raise ValueError("Legacy Hysteria obfs is missing")

with open(output_path, "w", encoding="utf-8") as stream:
    json.dump(
        {
            "hysteria_obfs": hysteria_obfs,
            "reality_private_key": private_key,
            "reality_short_id": short_id,
        },
        stream,
        indent=2,
        sort_keys=True,
    )
    stream.write("\n")
PY
    private_key=$(
        python3 -c \
            'import json, sys; print(json.load(open(sys.argv[1]))["reality_private_key"])' \
            "$temporary_file"
    )
    keypair=$(docker run --rm "$XRAY_IMAGE" x25519 -i "$private_key")
    public_key=$(
        printf '%s\n' "$keypair" |
            awk -F ': ' '/^(Password \(PublicKey\)|PublicKey|Password):/ {print $2; exit}'
    )
    if [ -z "$public_key" ]; then
        echo "Unable to derive the legacy REALITY public key" >&2
        exit 1
    fi
    python3 - "$temporary_file" "$public_key" <<'PY'
import json
import sys

path, public_key = sys.argv[1:]
with open(path, encoding="utf-8") as stream:
    state = json.load(stream)
state["reality_public_key"] = public_key
with open(path, "w", encoding="utf-8") as stream:
    json.dump(state, stream, indent=2, sort_keys=True)
    stream.write("\n")
PY
else
    keypair=$(docker run --rm "$XRAY_IMAGE" x25519)
    private_key=$(
        printf '%s\n' "$keypair" |
            awk -F ': ' '/^PrivateKey:/ {print $2; exit}'
    )
    public_key=$(
        printf '%s\n' "$keypair" |
            awk -F ': ' '/^(Password \(PublicKey\)|PublicKey|Password):/ {print $2; exit}'
    )
    short_id=$(openssl rand -hex 8)
    hysteria_obfs=$(openssl rand -hex 32)

    if [ -z "$private_key" ] || [ -z "$public_key" ]; then
        echo "Unable to parse Xray x25519 output" >&2
        exit 1
    fi

    printf '%s\n' \
        '{' \
        "  \"hysteria_obfs\": \"$hysteria_obfs\"," \
        "  \"reality_private_key\": \"$private_key\"," \
        "  \"reality_public_key\": \"$public_key\"," \
        "  \"reality_short_id\": \"$short_id\"" \
        '}' > "$temporary_file"
fi

chmod 0600 "$temporary_file"
mv "$temporary_file" "$state_file"
temporary_file=
